{
  "name": "db-lab",
  "version": "0.2.0",
  "private": true,
  "description": "DB Lab - a personal learning app for MongoDB and PostgreSQL (frontend only)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
